{
  "entities": {
    "survey": {
      "title": "survey",
      "description": "Srinivasa Heart Foundation Patient Health Survey submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auto-generated document ID" },
        "surveyDate": { "type": "string", "description": "Captured date of the survey (YYYY-MM-DD)" },
        "surveyTime": { "type": "string", "description": "Captured time of the survey (HH:MM)" },
        "uhid": { "type": "string", "description": "Unique Health ID (UHID) number" },
        "language": { "type": "string", "description": "Selected survey language ('te' or 'en')" },
        "personalDetails": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "string" },
            "gender": { "type": "string" },
            "occupation": { "type": "string" },
            "address": { "type": "string" },
            "home": { "type": "string" },
            "karyasthalam": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "responses": {
          "type": "object",
          "properties": {
            "generalHealthProblems": { "type": "boolean" },
            "generalHealthExplanation": { "type": "string" },
            "symptomChestPain": { "type": "boolean" },
            "chestPainSinceHowLong": { "type": "string" },
            "chestPainPart": { "type": "string" },
            "chestPainSide": { "type": "string" },
            "chestPainIntensity": { "type": "string" },
            "chestPainIncreasesWalking": { "type": "boolean" },
            "chestPainIncreasesClimbing": { "type": "boolean" },
            "chestPainIncreasesLifting": { "type": "boolean" },
            "chestPainReducesHow": { "type": "string" },
            "symptomBreathlessness": { "type": "boolean" },
            "symptomPalpitations": { "type": "boolean" },
            "symptomDizziness": { "type": "boolean" },
            "symptomSwellingLegs": { "type": "boolean" },
            "symptomFatigue": { "type": "boolean" },
            "breathlessnessSinceHowLong": { "type": "string" },
            "breathlessnessIncreasesWhen": { "type": "string" },
            "respiratorySymptoms": { "type": "string" },
            "digestiveSymptoms": { "type": "string" },
            "nervousSymptoms": { "type": "string" },
            "hadCovid": { "type": "boolean" },
            "covidDetails": { "type": "string" },
            "covidVaccinated": { "type": "string" },
            "hasInsurance": { "type": "boolean" },
            "insuranceDetails": { "type": "string" },
            "diabetes": { "type": "boolean" },
            "highBp": { "type": "boolean" },
            "diabetesBpSinceHowLong": { "type": "string" },
            "familyHeartDisease": { "type": "boolean" },
            "familySuddenDeathBefore60": { "type": "boolean" },
            "tobaccoUsageCigarette": { "type": "boolean" },
            "tobaccoUsageGutka": { "type": "boolean" },
            "tobaccoUsageOther": { "type": "string" },
            "highCholesterol": { "type": "boolean" },
            "previousMedicalExams": { "type": "string" },
            "currentMedicines": { "type": "string" },
            "ulcer": { "type": "boolean" },
            "asthma": { "type": "boolean" },
            "stroke": { "type": "boolean" },
            "fits": { "type": "boolean" },
            "nervousDisorders": { "type": "boolean" },
            "jointDiseases": { "type": "boolean" },
            "kidneyDisease: boolean": { "type": "boolean" },
            "thyroidDisease": { "type": "boolean" },
            "liverDisease": { "type": "boolean" },
            "cancer": { "type": "boolean" },
            "otherDisease": { "type": "string" },
            "hadSurgery": { "type": "boolean" },
            "surgeryDetails": { "type": "string" },
            "surgeryComplications": { "type": "string" },
            "hadHospitalization": { "type": "boolean" },
            "hospitalizationDetails": { "type": "string" },
            "previousHeartDisease": { "type": "boolean" },
            "heartDiseaseDetails": { "type": "string" },
            "sideEffects": { "type": "string" },
            "sleepQuality": { "type": "string" },
            "sleepProblems": { "type": "string" },
            "alcoholConsumption": { "type": "boolean" },
            "otherAddictions": { "type": "string" },
            "height": { "type": "string" },
            "weight": { "type": "string" },
            "dailyExercise": { "type": "boolean" },
            "exerciseType": { "type": "string" },
            "exerciseDuration": { "type": "string" },
            "vegetarian": { "type": "boolean" },
            "nonVegetarian": { "type": "boolean" },
            "fruitsIntake": { "type": "boolean" },
            "stress": { "type": "string" },
            "anxiety": { "type": "string" },
            "workPressure": { "type": "string" },
            "menstrualCycleRegular": { "type": "boolean" },
            "pregnant": { "type": "boolean" },
            "pregnancyComplications": { "type": "string" },
            "previousSurgeries": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["surveyDate", "surveyTime", "language", "personalDetails", "responses"]
    }
  },
  "firestore": {
    "/surveys/{surveyId}": {
      "schema": "survey",
      "description": "Storage of medical survey submissions"
    }
  }
}
